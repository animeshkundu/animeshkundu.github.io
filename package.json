{
  "name": "animeshkundu.github.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 5000",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:copy": "node scripts/check-copy.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:static": "node scripts/check-static.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "snapshot:repos": "node scripts/snapshot-repos.mjs",
    "snapshot:surfaces": "node scripts/snapshot-surfaces.mjs",
    "snapshot:essays": "node scripts/snapshot-essays.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "keywords": [
    "portfolio",
    "github-pages",
    "react",
    "typescript",
    "developer"
  ],
  "author": "Animesh Kundu",
  "license": "MIT",
  "description": "Static public work index for Animesh Kundu",
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/react": "^6.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitest/coverage-v8": "^4.1.10",
    "astro-eslint-parser": "^1.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.1.10"
  }
