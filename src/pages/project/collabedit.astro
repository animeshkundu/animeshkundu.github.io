---
import { withBase, canonicalUrl } from '../../lib/urls';

const destination = withBase('/projects/');
const canonical = canonicalUrl('/projects/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Project record moved | Animesh Kundu</title>
    <meta
      name="description"
      content="This retired project record now points to the current public work index."
    />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <main>
      <h1>This project record has moved.</h1>
      <p><a href={destination}>Continue to the current work index</a>.</p>
    </main>
  </body>
</html>
